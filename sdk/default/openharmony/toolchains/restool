#!/bin/bash
# restool wrapper: use box64 to run the x86-64 restool from the x64 toolchain on arm64.
# The arm64 toolchain ships no real restool binary, so the x64 one is emulated via box64.
BOX64_DIR="/mnt/linux_share/workspace/commandline-linux-arm64/box64"
export BOX64_LD_LIBRARY_PATH="$BOX64_DIR/x64lib"
REAL="$(cd "$(dirname "$0")" && pwd)/restool.x86_64"
exec "$BOX64_DIR/box64" "$REAL" "$@"
